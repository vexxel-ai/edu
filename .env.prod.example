# Production Environment Variables
# Copy this to .env on your EC2 instance

# Database - PostgreSQL on Docker
DATABASE_URL=postgresql://eduuser:YOUR_DB_PASSWORD@postgres:5432/edu_vexxel

# Supabase Configuration (get from https://supabase.com/dashboard/project/_/settings/api)
# Note: SUPABASE_ANON_KEY is now legacy - use SUPABASE_API_KEY instead
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_API_KEY=your-production-api-key
SUPABASE_JWT_SECRET=your-production-jwt-secret

# Super Admin Configuration
SUPER_ADMIN_EMAIL=admin@vexxel.ai
SUPER_ADMIN_PASSWORD=your-secure-password

# Database Password (must match docker-compose.prod.yml)
DB_PASSWORD=your-secure-db-password

# Environment
ENVIRONMENT=production
