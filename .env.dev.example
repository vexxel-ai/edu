# Local Development Environment Variables
# Copy this to .env for local development

# Database - PostgreSQL with docker-compose.dev.yml)
DATABASE_URL=postgresql://eduuser:devpassword@localhost:5432/edu_vexxel_dev

# Supabase Configuration (get from https://supabase.com/dashboard/project/_/settings/api)
# Note: SUPABASE_ANON_KEY is now legacy - use SUPABASE_API_KEY instead
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_API_KEY=your-api-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Super Admin Configuration
SUPER_ADMIN_EMAIL=admin@vexxel.ai
SUPER_ADMIN_PASSWORD=change-me-in-production

# Environment
ENVIRONMENT=development
